# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign login tokens (JWTs). Use a long random string.
JWT_SECRET=

# MySQL database (AWS RDS)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# S3 bucket used for resource uploads
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
